{
  "name": "jira-capacity-browser-ext",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Chrome extension that exports Jira capacity reports from the logged-in Jira tab.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "watch": "vite build --watch",
    "test": "node --test \"src/lib/**/*.test.js\"",
    "test:cli": "node --test \"cli/test/**/*.test.mjs\"",
    "test:all": "npm test && npm run test:cli",
    "cli": "node cli/src/index.mjs",
    "cli:build": "node cli/build.mjs",
    "icons": "node scripts/make-icons.mjs",
    "zip": "node scripts/package.mjs",
    "cli:zip": "node cli/package.mjs"
  },
  "dependencies": {
    "@mantine/core": "^9.8.1",
    "@mantine/hooks": "^9.8.1",
    "@tabler/icons-react": "^3.52.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@vitejs/plugin-react": "^6.0.3",
    "esbuild": "^0.28.2",
    "linkedom": "^0.18.11",
    "postcss": "^8.5.6",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "vite": "^8.1.3"
  }
}
