  "private": true,
  "description": "Chrome extension + web app template: React (ES6) + Supabase + SCSS",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:ext": "vite build --mode extension --watch",
    "build": "vite build --mode extension",
