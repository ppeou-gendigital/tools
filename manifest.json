{
  "manifest_version": 3,
  "name": "AEM Jump",
  "version": "0.1.0",
  "description": "Read the current AEM author URL and jump to editors, consoles, and tools.",
  "action": {
    "default_title": "AEM Jump",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["tabs", "storage"]
}
