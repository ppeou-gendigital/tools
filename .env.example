# Copy this file to `.env` and fill in real values from your Supabase project
# (Project Settings -> API). Both are safe to expose in a client bundle.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Google Maps JavaScript API + Places API (New) for office autocomplete.
# Optional — without it, doctor forms fall back to manual address fields.
# VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Firebase AI Logic (Gemini) for care chat. Optional — FAB hidden when unset.
# VITE_FIREBASE_AI_ENABLED=true
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=project-docto.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=project-docto
# VITE_FIREBASE_STORAGE_BUCKET=project-docto.appspot.com
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# App Check site key from Cloud/reCAPTCHA console.
# Cloud "v3/score" keys created under GCP use ReCaptchaEnterpriseProvider
# (USE_ENTERPRISE=true). Classic keys from google.com/recaptcha/admin use false.
# VITE_FIREBASE_APPCHECK_SITE_KEY=
# VITE_FIREBASE_APPCHECK_USE_ENTERPRISE=true
# VITE_FIREBASE_AI_MODEL=gemini-3.6-flash

# --- Dev-only auto-login (optional) -----------------------------------------
# Set these in `.env.local` (gitignored) so they never leak to teammates.
# Requires a matching entry in Supabase:
#   Dashboard -> Authentication -> Advanced Settings -> Test OTPs
# When present in a `npm run dev` / `npm run dev:ext` build, the app silently
# runs signInWithOtp + verifyOtp on mount and lands on the authed screen.
# `npm run build` / `npm run build:web` strip these entirely.
# VITE_DEV_AUTOLOGIN_EMAIL=dev@example.com
# VITE_DEV_AUTOLOGIN_TOKEN=123456
