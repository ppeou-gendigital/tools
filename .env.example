# Copy this file to `.env` and fill in real values from your Supabase project
# (Project Settings -> API). Both are safe to expose in a client bundle.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# --- Google Maps (optional; Map brainstorming page) -------------------------
# Google Cloud Console → enable Maps JavaScript API + Places API (New) + Places UI Kit,
# create an API key, restrict by HTTP referrer (localhost + your deploy origin).
# VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# --- YouTube Data API (optional; AI “search and add” playlist) --------------
# Enable YouTube Data API v3 on the same (or another) GCP project.
# If unset, Viaggio falls back to VITE_GOOGLE_MAPS_API_KEY for search.
# VITE_YOUTUBE_API_KEY=your-youtube-data-api-key

# --- Firebase AI Logic (optional; AI trip planner on web PWA) ----------------
# Firebase Console → project settings → Your apps → Web app config.
# AI Services → AI Logic → Gemini Developer API. App Check → reCAPTCHA v3.
# In local dev, register the App Check debug token printed in the browser console.
# VITE_FIREBASE_AI_ENABLED=true
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=project-viaggio.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=project-viaggio
# VITE_FIREBASE_STORAGE_BUCKET=project-viaggio.appspot.com
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_APPCHECK_SITE_KEY=
# VITE_FIREBASE_APPCHECK_USE_ENTERPRISE=false
# VITE_FIREBASE_AI_MODEL=gemini-3.6-flash

# --- Dev-only auto-login (optional) -----------------------------------------
# Set these in `.env.local` (gitignored) so they never leak to teammates.
# Requires a matching entry in Supabase:
#   Dashboard -> Authentication -> Advanced Settings -> Test OTPs
# When present in a `npm run dev` / `npm run dev:ext` build, the app silently
# runs signInWithOtp + verifyOtp on mount and lands on the authed screen.
# `npm run build` / `npm run build:web` strip these entirely.
# VITE_DEV_AUTOLOGIN_EMAIL=dev@example.com
# VITE_DEV_AUTOLOGIN_TOKEN=123456
