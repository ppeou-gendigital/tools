# Copy this file to `.env` and fill in real values from your Supabase project
# (Project Settings -> API). Both are safe to expose in a client bundle.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# --- Dev sign-in -------------------------------------------------------------
# Fast path (recommended): with the dev server running, `npm run dev:login`
# requests a real OTP, reads the code from Resend, and prints a one-shot URL
# that logs the app in — no typing, ~3s. Needs RESEND_API_KEY in your env plus
# VITE_DEV_AUTOLOGIN_EMAIL set to a per-app Resend "delivered" test inbox
# (Resend's reserved delivered address, sub-addressed per app) — NOT the
# "suppressed" test inbox, whose mail Resend marks suppressed.
# VITE_DEV_AUTOLOGIN_EMAIL=your-delivered-resend-test-inbox
#
# Optional static auto-login (only if you configure a matching Supabase
# Test OTP: Dashboard -> Authentication -> Advanced Settings -> Test OTPs).
# When both are set in a `npm run dev` build the app runs signInWithOtp +
# verifyOtp on mount. If no Test OTP is registered this silently fails — use
# `npm run dev:login` instead. `npm run build*` strips these entirely.
# VITE_DEV_AUTOLOGIN_TOKEN=123456
